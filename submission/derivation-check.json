          "default": null,
          "description": "Reward signal from the last action",
          "title": "Reward"
        },
        "metadata": {
          "additionalProperties": true,
          "description": "Additional metadata for the observation",
          "title": "Metadata",
          "type": "object"
        },
        "task_id": {
          "default": "",
          "description": "Task being played",
          "title": "Task Id",
          "type": "string"
        },
        "question": {
          "default": "",
          "description": "The question. Sent once, at reset.",
          "title": "Question",
          "type": "string"
        },
        "output": {
          "default": "",
          "description": "Result of the last action",
          "title": "Output",
          "type": "string"
        },
        "steps_left": {
          "default": 0,
          "description": "Actions left before the episode ends",
          "title": "Steps Left",
          "type": "integer"
        }
      },
      "title": "DerivationCheckObservation",
      "type": "object"
